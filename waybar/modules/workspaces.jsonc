    "hyprland/workspaces": {
        "disable-scroll": true,
        "rotate": ${r_deg},
        "all-outputs": true,
        "active-only": true,
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace -1",
        "on-scroll-down": "hyprctl dispatch workspace +1",
	"show-special":false ,
	"persistent_workspaces": {
	"1": [],
	"2": [],
	"3": [],
	"4": [],

},
	"format": "{name} ({id})"       
    },

